// LiteSQL Grammar for Lark Parser

start: statement ";"?

statement: create_statement
         | insert_statement
         | select_statement

// CREATE TABLE statements
create_statement: CREATE TABLE table_name "(" column_def_list ")"
column_def_list: column_def ("," column_def)*
column_def: column_name data_type [CONSTRAINT]
data_type: INT | INTEGER | TEXT | VARCHAR | FLOAT | DOUBLE

// INSERT statements
insert_statement: INSERT INTO table_name VALUES "(" value_list ")"
value_list: value ("," value)*
value: STRING | NUMBER | NULL

// SELECT statements
select_statement: SELECT select_expr FROM table_name [where_clause]
select_expr: "*" | column_list
column_list: column_name ("," column_name)*
where_clause: WHERE condition
condition: column_name comparison_op value

// Common components
comparison_op: "=" | "!=" | ">" | "<" | ">=" | "<="
table_name: IDENTIFIER
column_name: IDENTIFIER

// Keywords
CREATE: "CREATE"i
TABLE: "TABLE"i
INSERT: "INSERT"i
INTO: "INTO"i
VALUES: "VALUES"i
SELECT: "SELECT"i
FROM: "FROM"i
WHERE: "WHERE"i
CONSTRAINT: "NOT NULL"i | "PRIMARY KEY"i
NULL: "NULL"i
INT: "INT"i
INTEGER: "INTEGER"i
TEXT: "TEXT"i
VARCHAR: "VARCHAR"i
FLOAT: "FLOAT"i
DOUBLE: "DOUBLE"i

// Terminals
IDENTIFIER: /[a-zA-Z_][a-zA-Z0-9_]*/
STRING: /'[^']*'/ | /"[^"]*"/
NUMBER: /[+-]?[0-9]+(\.[0-9]+)?/

// Ignore whitespace and comments
COMMENT: /--[^\n]*/
%import common.WS
%ignore WS
%ignore COMMENT