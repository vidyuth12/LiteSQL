      "Select(\n",
      "  expressions=[\n",
      "    Column(\n",
      "      this=Identifier(this=name, quoted=False)),\n",
      "    Column(\n",
      "      this=Identifier(this=age, quoted=False))],\n",
      "  from=From(\n",
      "    this=Table(\n",
      "      this=Identifier(this=users, quoted=False))),\n",
      "  where=Where(\n",
      "    this=GT(\n",
      "      this=Column(\n",
      "        this=Identifier(this=age, quoted=False)),\n",
      "      expression=Literal(this=21, is_string=False))),\n",
      "  order=Order(\n",
      "    expressions=[\n",
      "      Ordered(\n",
      "        this=Column(\n",
      "          this=Identifier(this=age, quoted=False)),\n",
      "        desc=True,\n",
      "        nulls_first=False)]))\n"
     ]
    }
   ],
   "source": [
    "from sqlglot import parse_one\n",
    "\n",
    "sql = \"\"\"\n",
    "SELECT name, age \n",
    "FROM users \n",
    "WHERE age > 21 \n",
    "ORDER BY age DESC\n",
    "\"\"\"\n",
    "\n",
    "# Parse the SQL and get the expression (AST root)\n",
    "expression = parse_one(sql)\n",
    "\n",
    "print(repr(expression))"
   ]
  },
